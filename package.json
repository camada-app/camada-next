{
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "name": "@camada/next",
  "description": "camada backend SDK for Next.js: edge-safe middleware/proxy, /api/camada route handlers, <CamadaBeacon/> with the request rid",
  "homepage": "https://www.camada.app/docs/quickstart/nextjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camada-app/camada-next.git"
  },
  "bugs": {
    "url": "https://github.com/camada-app/camada-next/issues"
  },
  "keywords": [
    "camada",
    "nextjs",
    "next",
    "react",
    "vercel",
    "edge-middleware",
    "bot-detection",
    "bot-protection",
    "credential-stuffing",
    "account-takeover",
    "rate-limiting",
    "proof-of-work",
    "ai-scraper",
    "security"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@camada/core": "file:../camada-core",
    "@camada/browser": "file:../camada-browser",
    "@camada/react": "file:../camada-react"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^3.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "@types/react": "^19.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "esbuild": "^0.24.0",
    "@types/node": "^22.10.0"
  }
}
